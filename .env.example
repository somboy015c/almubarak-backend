# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Database ====
# Free MongoDB Atlas cluster connection string. See README for how to create one.
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/elmubarak?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of origins allowed to call this API
# Production: https://elmubarak.com.ng,https://www.elmubarak.com.ng
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ==== Email (Resend) ====
# 1. Create an API key at https://resend.com/api-keys
# 2. Add and verify elmubarak.com.ng at https://resend.com/domains (DNS records),
#    otherwise Resend only lets you send to your own email address.
# Leave RESEND_API_KEY blank locally: links are printed in the server console.
RESEND_API_KEY=
EMAIL_FROM=Elmubarak Digital Hub <no-reply@elmubarak.com.ng>
# Where the website lives. Used to build the links inside emails.
FRONTEND_URL=https://elmubarak.com.ng

# ==== Auth ====
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ==== Mode ====
# "mock" simulates providers so the app works with zero external accounts.
# "live" calls the real VTpass + Flutterwave APIs using the keys below.
PROVIDER_MODE=mock

# ==== VTpass (provider for airtime, data, electricity, cable, exam PINs) ====
# Sandbox (testing):  https://sandbox.vtpass.com/api
# Live:               https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
# From VTpass dashboard -> Profile -> API Settings
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Admin dashboard shows a warning when your VTpass wallet falls below this (Naira)
VTPASS_LOW_BALANCE_ALERT=10000

# ==== Flutterwave (wallet funding + withdrawals/payouts) ====
# Dashboard -> Settings -> API Keys. Use TEST keys first, then LIVE.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# Any random string you invent. Paste the SAME value into Flutterwave's
# webhook settings as the "Secret hash". Generate: openssl rand -hex 24
FLW_SECRET_HASH=
# Public URL of THIS backend (used for payout callbacks), e.g. https://almubarak-backend.onrender.com
API_PUBLIC_URL=

# ==== Airtime-to-cash automatic verification (optional) ====
# There's no single standard API for this the way VTpass covers airtime
# purchases ‚Äî most VTU platforms verify these manually. If you contract
# with a provider that offers automatic verification, put their endpoint
# and key here; the "Automatic" option falls back to manual review if
# these are left blank.
AIRTIME2CASH_API_URL=
AIRTIME2CASH_API_KEY=

# ==== Admin bootstrap ====
# First user registered with this email is automatically made admin.
ADMIN_EMAIL=admin@elmubarakdigitalhub.com

