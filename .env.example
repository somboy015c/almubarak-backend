# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Database ====
# Free MongoDB Atlas cluster connection string. See README for how to create one.
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/almubarak?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated list of origins allowed to call this API
# e.g. https://yourusername.github.io
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ==== Auth ====
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ==== Mode ====
# "mock" simulates providers so the app works with zero external accounts.
# "live" calls the real VTpass + Paystack APIs using the keys below.
PROVIDER_MODE=mock

# ==== VTpass (VTU provider) ====
# Sign up at https://vtpass.com -> Sandbox for testing, then live keys for production.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_EMAIL=
VTPASS_PASSWORD=
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# ==== Paystack (payment gateway, for wallet funding AND automated withdrawals) ====
# Sign up at https://paystack.com -> get test keys first, then live keys.
# Transfers (withdrawals) need Paystack to separately approve your business
# for that feature — ask their support once your account is verified.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ==== Airtime-to-cash automatic verification (optional) ====
# There's no single standard API for this the way VTpass covers airtime
# purchases — most VTU platforms verify these manually. If you contract
# with a provider that offers automatic verification, put their endpoint
# and key here; the "Automatic" option falls back to manual review if
# these are left blank.
AIRTIME2CASH_API_URL=
AIRTIME2CASH_API_KEY=

# ==== Admin bootstrap ====
# First user registered with this email is automatically made admin.
ADMIN_EMAIL=admin@almubarakdigitalhub.com
